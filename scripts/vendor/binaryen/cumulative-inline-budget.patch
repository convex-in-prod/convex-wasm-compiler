--- /dev/null
+++ b/test/lit/passes/inlining-cumulative-size.wat
@@ -0,0 +1,43 @@
+;; Every individual call fits the limit. Their sum does not. Charge chosen
+;; actions before the next call is considered, even within one iteration.
+;; RUN: wasm-opt %s --inlining --inline-max-combined-binary-size=50 -S -o - | filecheck %s --check-prefix=BOUNDED
+;; RUN: wasm-opt %s --inlining --inline-max-combined-binary-size=250 -S -o - | filecheck %s --check-prefix=LARGE
+;; BOUNDED-LABEL: (func $main
+;; BOUNDED: (call $observe
+;; BOUNDED: (call $b)
+;; BOUNDED: (call $c)
+;; BOUNDED: (call $d)
+;; LARGE-LABEL: (func $main
+;; LARGE-NOT: (call $a)
+;; LARGE-NOT: (call $b)
+;; LARGE-NOT: (call $c)
+;; LARGE-NOT: (call $d)
+
+(module
+ (import "env" "observe" (func $observe (param i32)))
+ (func $a
+  (call $observe (i32.const 0))
+  (call $observe (i32.const 1))
+  (call $observe (i32.const 2))
+  (call $observe (i32.const 3)))
+ (func $b
+  (call $observe (i32.const 4))
+  (call $observe (i32.const 5))
+  (call $observe (i32.const 6))
+  (call $observe (i32.const 7)))
+ (func $c
+  (call $observe (i32.const 8))
+  (call $observe (i32.const 9))
+  (call $observe (i32.const 10))
+  (call $observe (i32.const 11)))
+ (func $d
+  (call $observe (i32.const 12))
+  (call $observe (i32.const 13))
+  (call $observe (i32.const 14))
+  (call $observe (i32.const 15)))
+ (func $main (export "main")
+  (call $a)
+  (call $b)
+  (call $c)
+  (call $d))
+)
