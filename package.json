{
  "name": "convex-wasm-compiler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@babel/parser": "7.29.7"
  },
  "scripts": {
    "build:compiler": "cargo build --locked --release --manifest-path scripts/convex-wasm-compiler/Cargo.toml",
    "build:precompiler": "cargo build --locked --release --manifest-path scripts/convex-wasm-precompiler/Cargo.toml",
    "check:js": "node scripts/check-javascript.mjs",
    "package:compiler": "node scripts/package-convex-wasm-compiler.mjs",
    "package:precompiler": "node scripts/package-convex-wasm-precompiler.mjs",
    "release:native": "node scripts/build-native-release.mjs",
    "smoke:compiler": "node scripts/smoke-packaged-convex-wasm-compiler.mjs",
    "smoke:precompiler": "node scripts/smoke-packaged-convex-wasm-precompiler.mjs",
    "test": "npm run test:compiler && npm run test:precompiler && npm run test:invariants",
    "test:compiler": "cargo test --locked --manifest-path scripts/convex-wasm-compiler/Cargo.toml",
    "test:invariants": "cargo test --locked --manifest-path scripts/convex-wasm-compiler/invariant-validation/Cargo.toml",
    "test:precompiler": "cargo test --locked --manifest-path scripts/convex-wasm-precompiler/Cargo.toml"
  }
}
