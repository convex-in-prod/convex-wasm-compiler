+// The sandbox must discard an instance after native allocation exhaustion.
+// Returning null allows some ICU paths to select unrelated formatting defaults.
+static void *checkedAllocation(void *memory) {
+#if HERMES_ICU_FAIL_STOP_ALLOCATION
+    if (memory == nullptr) {
+        __builtin_trap();
+    }
+#endif
+    return memory;
+}
